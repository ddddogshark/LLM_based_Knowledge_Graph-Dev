# ===========================================================================
# LLM-based Knowledge Graph Builder — Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# LLM API (supports OpenAI-compatible APIs: Qwen, DeepSeek, GPT, etc.)
# ---------------------------------------------------------------------------
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://your-llm-api-endpoint/v1/chat/completions
LLM_MODEL=Qwen
LLM_API_KEY_PREFIX=

# Optional: separate DeepSeek endpoint (if different from LLM_API_URL)
# DEEPSEEK_API_KEY=your_deepseek_key
# DEEPSEEK_API_URL=https://your-deepseek-endpoint

# ---------------------------------------------------------------------------
# Neo4j Graph Database
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# MySQL Database (optional — for raw data storage)
# ---------------------------------------------------------------------------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DB=knowledge_graph_raw_data

# ---------------------------------------------------------------------------
# Redis (optional — for caching and task queues)
# ---------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
